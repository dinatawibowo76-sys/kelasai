# ============================================
# KelasAI Caddyfile — Production Reverse Proxy
# ============================================
#
# HOW TO USE:
#
# 1. HTTP only (testing / no domain):
#    The default :80 block below works out of the box.
#
# 2. HTTPS with your own domain:
#    - Replace YOUR_DOMAIN with your actual domain (e.g. kelasai.sekolah.id)
#    - Uncomment the HTTPS block below
#    - Comment out or remove the :80 block
#    - Caddy will auto-provision a Let's Encrypt certificate
#
# 3. Custom SSL/TLS certificates:
#    - Add your cert and key paths:
#      tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
#
# TIPS:
# - Make sure ports 80 and 443 are open on your firewall
# - DNS for your domain must point to this server's IP
# - Caddy automatically handles HTTP→HTTPS redirect
# - For multiple domains, duplicate the block
# ============================================

# ---- HTTP (default, no domain) ----
:80 {
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Compression
    encode gzip zstd
}

# ---- HTTPS (uncomment when you have a domain) ----
